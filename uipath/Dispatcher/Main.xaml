this:Main.in_Eingabedatei="..\..\data\Eingang_Batch1.xlsx"
this:Main.in_OrchestratorOrdner="Musterbank_Test"
this:Main.in_QueueName="FSA_Eingang"
sap2010:WorkflowViewState.IdRef="ActivityBuilder_1">
    <x:Members>
        <x:Property Name="in_Eingabedatei" Type="InArgument(x:String)" />
        <x:Property Name="in_OrchestratorOrdner" Type="InArgument(x:String)" />
        <x:Property Name="in_QueueName" Type="InArgument(x:String)" />
    </x:Members>
    <TextExpression.NamespacesForImplementation>
        <sco:Collection x:TypeArguments="x:String">
            <x:String>System.Activities</x:String>
            <x:String>System.Activities.Statements</x:String>
            <x:String>System.Activities.Expressions</x:String>
            <x:String>System.Activities.Validation</x:String>
